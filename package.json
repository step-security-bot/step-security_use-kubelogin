{
  "name": "use-kubelogin",
  "version": "1.3.0",
  "private": true,
  "description": "Setup kubelogin in GitHub Actions",
  "main": "lib/index.js",
  "scripts": {
    "build": "npm run format && ncc build src/run.ts -o dist",
    "local:run": "npm run build && node lib/index.js",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "test-ci": "npm run lint && npm run format-check && npm run test-coverage && ./hack/ensure-generated.sh",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/use-kubelogin.git"
  },
  "keywords": [
    "kubelogin",
    "actions"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/use-kubelogin/issues"
  },
  "homepage": "https://github.com/step-security/use-kubelogin#readme",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.14.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.29.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.4",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/tool-cache": "^2.0.1",
    "@octokit/action": "^4.0.10",
    "axios": "^1.20.0"
  }
}
